[Unit]
Description=ICP Safety VLM Sentry (Jetson standalone)
After=network-online.target
Wants=network-online.target
# StartLimit* belong in [Unit], not [Service] — an earlier version of
# this file had them in [Service], where systemd silently ignores them
# ("Unknown key name 'StartLimitIntervalSec' in section 'Service'" in
# `journalctl -u icp-safety-sentry`), so the crash-loop protection never
# actually applied during the 2026-09-14 OOM-kill incident (10 restarts
# with zero throttling). Fixed here.
StartLimitIntervalSec=300
StartLimitBurst=8

[Service]
Type=simple
User=icp
WorkingDirectory=/home/icp/projects/icp_safety_vlm
Environment=PATH=/home/icp/.local/bin:/usr/bin:/bin
# Locks every request to vlm_paligemma (fp16) regardless of the dropdown
# or ?backend= query — not just a default. This is the structural fix
# for the 2026-09-14 OOM-kill (concurrent yolo_hsv + vlm_paligemma both
# resident at once exceeded the Jetson's 7.4GB shared pool): with only
# one backend ever selectable, only one can ever be resident, so two
# Sentries can never compete for memory. Chosen over locking to
# vlm_paligemma_quantized because quantized's real memory win turned out
# smaller than first measured (corrected in system-design-integration.md:
# ~5.6-6GB real footprint, not the ~2.6GB tensor-allocator figure) and
# it's slower with no accuracy upside — see that doc's Solution A
# quantization finding. Re-evaluate if fp16-alone ever gets close to the
# 7.4GB ceiling on its own (GNOME desktop overhead + fp16 weights).
Environment=LOCKED_BACKEND=vlm_paligemma
ExecStart=/home/icp/.local/bin/uv run uvicorn icp_safety_vlm.server.app:app --host 0.0.0.0 --port 8010
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
